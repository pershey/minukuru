{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minukuru Quiz Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "title",
    "difficulty",
    "instruction",
    "segments",
    "correctSegmentIds",
    "explanation",
    "verificationTip",
    "hint",
    "recommendedReasonTags",
    "accessTier",
    "contentFlavor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "一意な問題 ID。例: premium-scam-001"
    },
    "mode": {
      "type": "string",
      "enum": ["explanationSnipe", "newsPoison", "scamAdChecker", "profileHunter", "conspiracyTrap"]
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "description": "問題タイトル。自然で短い日本語。"
    },
    "phoneticTitle": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "normal", "hard"]
    },
    "instruction": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "phoneticInstruction": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "segments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120,
            "description": "1 セグメントは短文 1 つ。"
          },
          "phoneticText": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        }
      }
    },
    "correctSegmentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^s[0-9]+$"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 260
    },
    "phoneticExplanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "verificationTip": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "phoneticVerificationTip": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280
    },
    "hint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "phoneticHint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "recommendedReasonTags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "suspiciousNumber",
          "noSource",
          "tooStrongClaim",
          "fearMongering",
          "urgency",
          "tooGoodToBeTrue",
          "fakeAuthority",
          "secretInfo",
          "enemyFraming",
          "forcedConnection",
          "hardToVerify",
          "gutFeeling"
        ]
      }
    },
    "accessTier": {
      "type": "string",
      "enum": ["free", "premium"]
    },
    "contentFlavor": {
      "type": "string",
      "enum": ["standard", "realWorld"]
    }
  }
}
