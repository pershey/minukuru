{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minukuru Quiz Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "mode",
    "title",
    "difficulty",
    "instruction",
    "segments",
    "correctSegmentIds",
    "explanation",
    "verificationTip",
    "hint",
    "recommendedReasonTags",
    "accessTier",
    "contentFlavor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "一意な問題 ID。例: premium-scam-001"
    },
    "mode": {
      "type": "string",
      "enum": ["explanationSnipe", "newsPoison", "scamAdChecker", "profileHunter", "conspiracyTrap"]
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 40,
      "description": "問題タイトル。自然で短い日本語。"
    },
    "phoneticTitle": {
      "type": "string",
      "minLength": 4,
      "maxLength": 60
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "normal", "hard"]
    },
    "instruction": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "phoneticInstruction": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "segments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120,
            "description": "1 セグメントは短文 1 つ。"
          },
          "phoneticText": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160
          }
        }
      }
    },
    "correctSegmentIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "string",
        "pattern": "^s[0-9]+$"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 260
    },
    "phoneticExplanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 320
    },
    "verificationTip": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "phoneticVerificationTip": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280
    },
    "hint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "phoneticHint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "recommendedReasonTags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "suspiciousNumber",
          "noSource",
          "tooStrongClaim",
          "fearMongering",
          "urgency",
          "tooGoodToBeTrue",
          "fakeAuthority",
          "secretInfo",
          "enemyFraming",
          "forcedConnection",
          "hardToVerify",
          "gutFeeling"
        ]
      }
    },
    "accessTier": {
      "type": "string",
      "enum": ["free", "premium"]
    },
    "contentFlavor": {
      "type": "string",
      "enum": ["standard", "realWorld"]
    },
    "audience": {
      "type": "string",
      "enum": ["child", "adult", "general"]
    },
    "learningStage": {
      "type": "string",
      "enum": ["example", "practice", "action", "challenge"]
    },
    "learningFocus": {
      "type": "string",
      "enum": ["pause", "evidence", "verify", "consult"]
    },
    "responseType": {
      "type": "string",
      "enum": ["selectSegments", "singleChoice"]
    },
    "answerChoices": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "semantic"],
        "properties": {
          "id": {"type": "string", "pattern": "^c[0-9]+$"},
          "text": {"type": "string", "minLength": 4, "maxLength": 100},
          "phoneticText": {"type": "string", "minLength": 4, "maxLength": 140},
          "semantic": {
            "type": "string",
            "enum": ["suspicious", "noIssueFound", "insufficientInformation", "pause", "verifySource", "consultTrustedPerson", "other"]
          }
        }
      }
    },
    "correctChoiceId": {
      "type": ["string", "null"],
      "pattern": "^c[0-9]+$"
    },
    "attentionPoint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 220
    },
    "phoneticAttentionPoint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 280
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["responseType"],
        "properties": {"responseType": {"const": "singleChoice"}}
      },
      "then": {
        "required": ["answerChoices", "correctChoiceId"],
        "properties": {
          "answerChoices": {"minItems": 2},
          "correctSegmentIds": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "correctSegmentIds": {"minItems": 1}
        }
      }
    }
  ]
}
